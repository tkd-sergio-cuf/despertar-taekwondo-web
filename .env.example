# Supabase project URL and publishable (public) key.
# Local: values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email notification for each free class request (https://resend.com).
# Leave empty to skip the email; requests are still saved in the database.
RESEND_API_KEY=
# Who receives the notification (comma-separated for several).
NOTIFICATION_EMAIL_TO=
# Sender. Without a verified domain use "onboarding@resend.dev" (it only
# delivers to the email of the Resend account).
NOTIFICATION_EMAIL_FROM=
